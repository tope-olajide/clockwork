# Clockwork local development
PORT=3000
NODE_ENV=development
CLOCKWORK_PUBLIC_URL=http://localhost:5173

# Optional OpenAI-compatible model relay (keys never reach the browser).
# The server loads .env.local / .env itself; these aliases work in either file.
# AI_MOCK=1
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Kane CLI integration — built in and required, no feature flag.
# Install it and run `kane-cli login` before starting the API.
# Leave unset to watch Chrome during a demo. Set 1 for headless/CI.
# KANE_HEADLESS=1
KANE_TIMEOUT_SECONDS=180
KANE_MAX_STEPS=40
KANE_CLI=kane-cli
KANE_AI_PLAY_EVIDENCE_DIR=./.data/ai-play

# Tests: point the runner at the deterministic fixture instead of the real CLI.
# KANE_CLI=scripts/kane/fake-kane.mjs

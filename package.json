{
  "name": "clockwork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b tsconfig.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b tsconfig.json tsconfig.node.json",
    "check:repo": "node scripts/check-repo.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "start": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@hono/node-server": "^2.1.8",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "better-sqlite3": "^13.2.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "immer": "^11.2.10",
    "lucide-react": "^0.468.0",
    "nanoid": "^6.0.2",
    "pixi.js": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.3.8"
  }
}
